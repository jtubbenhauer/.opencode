{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "disable": false,
      "model": "openrouter/minimax-m3"
    },
    "plan": {
      "disable": false,
      "model": "openrouter/minimax-m3"
    },
    "standards-enforcer": {
      "disable": true
    },
    "storybook-master": {
      "disable": true
    },
    "title": {
      "model": "openrouter/gpt-5-nano"
    },
    "summary": {
      "model": "openrouter/minimax-m3"
    },
    "compaction": {
      "model": "openrouter/minimax-m3"
    },
    "general": {
      "model": "openrouter/minimax-m3"
    },
    "explore": {
      "model": "openrouter/deepseek-v4-flash"
    },
    "scout": {
      "model": "openrouter/deepseek-v4-flash"
    },
    "rubber-duck": {
      "model": "openrouter/minimax-m3"
    }
  },
  "autoupdate": true,
  "instructions": [
    ".github/instructions/*.md",
    "~/.config/opencode/instructions/*.md",
    "~/.config/opencode/instructions/caveman.instructions.md"
  ],
  "mcp": {
    "clickup": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "mcp-remote", "https://mcp.clickup.com/mcp"],
      "environment": {
        "CLICKUP_MCP_LICENSE_KEY": "{env:CLICKUP_MCP_LICENSE_KEY}",
        "CLICKUP_API_KEY": "{env:CLICKUP_API_KEY}",
        "CLICKUP_TEAM_ID": "{env:CLICKUP_TEAM_ID}",
        "DOCUMENT_SUPPORT": "true"
      }
    },
    "engram": {
      "command": ["/home/jack/go/bin/engram", "mcp", "--tools=agent"],
      "enabled": false,
      "type": "local"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_KEY}"
      }
    }
  },
  "model": "openrouter/minimax-m3",
  "small_model": "openrouter/gpt-5-nano",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "plugin": ["@tarquinen/opencode-dcp@latest"]
}
